# Server-side configuration; keep the live copy root-owned at /etc/ipnodecloak.env.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=11967
ALLOWED_DOMAINS=ip.nodecloak.com
DATASET_AUTO_UPDATE=true
DATASET_UPDATE_CRON="30 4 * * *"
LOG_HTTP=false
LOG_LEVEL=warn
SECURITY_RATE_LIMIT=180
SECURITY_DELAY_AFTER=90
# Optional server-only report credentials. Never prefix with VITE_ or send them to clients.
CLOUDFLARE_API_KEY=
PROXYCHECK_API_KEY=
ABUSEIPDB_API_KEY=
SPAMHAUS_DQS_KEY=
# Optional dedicated recursive DNS server(s), comma-separated; DNSBL controls must pass.
IP_REPORT_DNS_SERVERS=
