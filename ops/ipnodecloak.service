# Isolated IP.NodeCloak API. Static assets are served by nginx.
[Unit]
Description=IP.NodeCloak IP and network toolbox API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ipnodecloak
Group=ipnodecloak
WorkingDirectory=/srv/ipnodecloak/current
EnvironmentFile=/etc/ipnodecloak.env
Environment=NODE_ENV=production
Environment=PATH=/opt/ipnodecloak/node-v24.22.0-linux-x64/bin:/usr/bin:/bin
ExecStart=/opt/ipnodecloak/node-v24.22.0-linux-x64/bin/node --import ./sentry-instrument.js backend-server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ipnodecloak
UMask=0027
MemoryMax=768M

[Install]
WantedBy=multi-user.target
