# Isolated Hoplens API. Static assets are served by nginx.
[Unit]
Description=Hoplens IP and network toolbox API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hoplens
Group=hoplens
WorkingDirectory=/srv/hoplens/current
EnvironmentFile=/etc/hoplens.env
Environment=NODE_ENV=production
Environment=PATH=/opt/hoplens/node-v24.22.0-linux-x64/bin:/usr/bin:/bin
ExecStart=/opt/hoplens/node-v24.22.0-linux-x64/bin/node --import ./sentry-instrument.js backend-server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hoplens
UMask=0027
MemoryMax=768M

[Install]
WantedBy=multi-user.target
